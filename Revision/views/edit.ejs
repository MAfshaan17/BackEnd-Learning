<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit File</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body>
    <div class="main w-full min-h-screen bg-zinc-900">
        <a href="/" class="text-blue-500 hover:underline inline-block mt-10">
            GO BACK to home
        </a>
        <form action="/edit" method="post" class="form p-10">
            <input 
                class="block w-2/4 rounded-md px-5 py-2 mb-4"
                type="text"
                name="previous"
                placeholder="Enter previous title"
                value="<%= filename %>"
            >
            <input 
                class="block w-2/4 rounded-md px-5 py-2 mb-4"
                type="text"
                placeholder="Enter new name"
                name="new"
            >
            <input 
                class="mt-2 bg-pink-500 text-white p-2 rounded-md cursor-pointer"
                type="submit"
                value="Update file name"
            >
        </form>
    </div>
</body>
</html>