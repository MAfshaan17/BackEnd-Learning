<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Revision</title>

    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body>

    <div class="main w-full min-h-screen bg-zinc-900">
    
        <!-- FORM -->
        <div class="form p-10">

            <form action="">

                <input
                    class="block px-5 py-2 rounded-md mb-4"
                    type="text"
                    placeholder="Enter your text here"
                >

                <textarea
                    class="block px-5 py-2 rounded-md mb-4"
                    placeholder="Enter your text here"
                ></textarea>

                <input
                    class="mt-2 bg-blue-500 text-white p-2 rounded-md cursor-pointer"
                    type="submit"
                    value="Submit"
                >

            </form>

        </div>
     
        <!-- TASKS CONTAINER -->
        <div class="tasks flex gap-6 flex-wrap px-10">

            <!-- TASK 1 -->
            <div class="task w-72  px-5 py-5 bg-zinc-800 rounded-md">

                <h1 class="text-white text-3xl tracking-tighter">
                    Some task goes here.
                </h1>

                <a
                    href=""
                    class="text-blue-500 hover:underline inline-block mt-3"
                >
                    View more
                </a>

            </div>
            <div class="task w-72 px-5 py-5 bg-zinc-800 rounded-md">
                <h1 class="text-white text-3xl tracking-tighter">
                    Some task goes here.
                </h1>
                <a
                    href=""
                    class="text-blue-500 hover:underline inline-block mt-3"            >
                    View more
                </a>
            </div>

            <div class="task w-72 px-5 py-5 bg-zinc-800 rounded-md">

                <h1 class="text-white text-3xl tracking-tighter">
                    Some task goes here.
                </h1>

                <a  href=""
                    class="text-blue-500 hover:underline inline-block mt-3"
                >
                    View more
                </a>

            </div>
           <% if(files.length> 0) { %>
                <% files.forEach(function(val) { %>
                    
          <% }) %>
          <% } else { %>
             <h3 class="text-white text-3xl tracking-tighter">
                    No files found.
                </h3>
            <% } %> 
        </div>

    </div>

</body>

</html>