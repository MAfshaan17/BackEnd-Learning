<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset ="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>Document</title>
        <link rel="stylesheets" href="/stylesheets/style.css">
         <script src="https://cdn.tailwindcss.com"></script>
    </head>  
 <body>
    <div class ="w-full h-full p-10 text-white "></div>
    <div class="nav mb-10">
        <a class="text-orange-500" href="/read">Read Users</a>
    </div>
    
    <h1 class="text-3xl tracking-tighter" >edit User</h1>  
    <form action="/update/<%= user._id %> " method="post"> 
         <input class="px-5 py-2 border-2 border-zinc-800 outline-none round" type="text" name="name" placeholder="name" value="<%= user.name %>">
         <input class="px-5 py-2 border-2 border-zinc-800  outline-none round" type="text" name="email" placeholder="email" value="<%= user.email %>">
         <input class="px-5 py-2 border-2 border-zinc-800  outline-none round" type="text" name="image" placeholder="Image url" value="<%= user.image %>">
           <input class="px-5 py-2 bg-yellow-500 rounded-lg ml-3 " type="submit" value="Update User"> 
         
       </form>
   </body>   
</html>