<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset ="UTF-8">
        <meta name=" viewport" content=""width=device-width, initial-scale="1.0">
        <title>Document</title>
        <link rel="stylesheets" href="/stylesheets/style.css">
         <script src="https://cdn.tailwindcss.com"></script>
    </head>  
 <body>
    <div class ="w-full h-full p-10 text-white "></div>
    <a class="text-blue-500" href="/">Back to home</a>
    <h1 class="text-3xl tracking-tighter mb-3 mt-10" >All Users</h1>  
    <div class="users flex gap-3 flex-wrap">
      <% users.forEach(function(user){ %>
        <div class="user w-72 p-4 bg-zinc-800 rounded-lg">
           <div class="w-full h-72 rounded-lg bg-zinc-500 overflow-hidden">
             <img class="w-full h-full object-cover object-center" src="<%= user.image %>" alt="">
           </div>
            <h3 class="text-xl mt-3 tracking-tighter"><%= user.name %></h3>
            <h4 class="text-zinc-500"><%= user.email %> </h4>
            <div class="flex gap-3 mt-10">
                <a class="text-zinc-200" href="">Edit User</a>
                <a class="text-red-400" class="" href="" >Delete User</a>
            </div>
        </div>
    <% }) %> 
     
        </div>
    </div>
   </body>   
</html>