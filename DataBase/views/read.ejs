<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>All Users</title>

    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body>

    <div class="w-full min-h-screen p-10 bg-zinc-900 text-white">

        <a class="text-blue-500" href="/">
            Back to home
        </a>

        <h1 class="text-3xl tracking-tighter mb-5 mt-10">
            All Users
        </h1>

        <div class="users flex gap-3 flex-wrap">

            <% users.forEach(function(user) { %>

                <div class="user w-72 p-4 bg-zinc-800 rounded-lg">

                    <!-- Image -->
                    <div class="w-full h-72 rounded-lg bg-zinc-500 overflow-hidden">

                        <img
                            class="w-full h-full object-cover object-center"
                            src="<%= user.image %>"
                            alt="<%= user.name %>"
                        >

                    </div>

                    <!-- User details -->
                    <h3 class="text-xl mt-3 tracking-tighter">
                        <%= user.name %>
                    </h3>

                    <h4 class="text-zinc-500">
                        <%= user.email %>
                    </h4>

                    <!-- Buttons -->
                    <div class="flex gap-3 mt-10">

                        <a
                            class="text-zinc-200"
                            href="/edit/<%= user._id %>"
                        >
                            Edit User
                        </a>

                        <a
                            class="text-red-400"
                            href="/delete/<%= user._id %>"
                        >
                            Delete User
                        </a>

                    </div>

                </div>

            <% }) %>

        </div>

    </div>

</body>
</html>